# Copy to app/.env (gitignored). Without these two values the app runs as a sample build with
# accounts off. Both are public by design: row-level security protects the data.
#
# Local stack (`npm run db:start` from the repo root prints both):
#   iOS simulator:    http://127.0.0.1:54321
#   Android emulator: http://10.0.2.2:54321
EXPO_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
