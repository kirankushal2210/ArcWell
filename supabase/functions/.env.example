# Copy to supabase/functions/.env for local Edge Functions (never commit .env).
# In staging/production set these with `npx supabase secrets set`.
AI_PROVIDER=groq
GROQ_API_KEY=
GROQ_MODEL=

# Billing webhooks (B7). Use test values locally; in staging and production set the secrets from
# the RevenueCat dashboard (webhook Authorization header) and Razorpay (webhook secret).
REVENUECAT_WEBHOOK_AUTH=
RAZORPAY_WEBHOOK_SECRET=

# Investor demos only (demo-billing function): "on" lets the paywall grant a 7-day Plus trial without
# Google Play. Leave unset in production.
DEMO_BILLING=

# Scheduled jobs (cron function, D111). Any long random string; the same value goes in Vault as
# `cron_secret` (see doc 10). Without it the cron function refuses every call.
CRON_SECRET=
